# Supabase — camada de analytics append-only do Quiz VITTALLE
# Onde pegar: Supabase Dashboard > seu projeto > Project Settings > API
#   VITE_SUPABASE_URL      = "Project URL"
#   VITE_SUPABASE_ANON_KEY = chave "anon" / "public" (NUNCA a "service_role")
#
# Sem essas duas variáveis, o quiz funciona normalmente — o analytics
# simplesmente vira no-op (não grava nada, só avisa no console).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
